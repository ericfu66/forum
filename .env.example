# Flask配置
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this
DEBUG=True

# 数据库配置
DATABASE_URI=sqlite:///forum.db

# DeepSeek API配置（全局默认）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=2000
DEEPSEEK_TEMPERATURE=0.7

# 图像生成API配置
AI_IMAGE_API_KEY=sk-your-image-api-key
AI_IMAGE_API_BASE=https://your-image-api.com/v1
AI_IMAGE_FALLBACK_API_KEY=sk-your-fallback-key
AI_IMAGE_FALLBACK_API_BASE=https://fallback-api.com/v1

# 视觉理解API配置
VISION_API_KEY=sk-your-vision-api-key
VISION_API_BASE=https://your-vision-api.com/v1

# Embedding向量化配置 (SiliconFlow API)
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-your-embedding-api-key
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=1024

# 联网搜索配置
TAVILY_API_KEY=tvly-your-tavily-key

# AI功能开关
AI_ROAST_ENABLED=true
AI_ROAST_PROBABILITY=0.10
AI_CHAT_ENABLED=true
AI_WRITE_ENABLED=true
AI_IMAGE_ENABLED=true

# 时区配置（中国时区为8，解决Linux服务器时间差异问题）
TIMEZONE_OFFSET=8

# AI系统提示词
AI_ROAST_SYSTEM_PROMPT=你是一个幽默风趣的AI评论员，喜欢吐槽但保持友善。你的吐槽应该有趣但不冒犯他人。
AI_CHAT_SYSTEM_PROMPT=你是一个乐于助人的AI助手，能够回答各种问题并提供有用的建议。
AI_WRITE_SYSTEM_PROMPT=你是一个专业的内容创作者，擅长撰写清晰、有吸引力的文章。

# 速率限制
AI_RATE_LIMIT_PER_HOUR=20
AI_RATE_LIMIT_PER_DAY=100

# 上传配置
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# 会话配置
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=604800

# CSRF配置
WTF_CSRF_ENABLED=True
WTF_CSRF_TIME_LIMIT=3600

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# Celery 配置
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# SocketIO消息队列（可选，多实例部署时配置）
# SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/3
