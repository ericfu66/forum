# Flask配置
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this
DEBUG=True

# MongoDB配置
MONGO_URI=mongodb://localhost:27017/forum_db
MONGO_DB_NAME=forum_db

# DeepSeek API配置
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=2000
DEEPSEEK_TEMPERATURE=0.7

# AI功能开关
AI_ROAST_ENABLED=true
AI_ROAST_PROBABILITY=0.10
AI_CHAT_ENABLED=true
AI_WRITE_ENABLED=true
AI_IMAGE_ENABLED=true

# 时区配置（中国时区为8，解决Linux服务器时间差异问题）
TIMEZONE_OFFSET=8

# AI系统提示词
AI_ROAST_SYSTEM_PROMPT=你是一个幽默风趣的AI评论员，喜欢吐槽但保持友善。你的吐槽应该有趣但不冒犯他人。
AI_CHAT_SYSTEM_PROMPT=你是一个乐于助人的AI助手，能够回答各种问题并提供有用的建议。
AI_WRITE_SYSTEM_PROMPT=你是一个专业的内容创作者，擅长撰写清晰、有吸引力的文章。

# 速率限制
AI_RATE_LIMIT_PER_HOUR=20
AI_RATE_LIMIT_PER_DAY=100

# 上传配置
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# 会话配置
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=604800

# Embedding 向量化配置 (SiliconFlow API)
# EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-your-embedding-api-key
# EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_TIMEOUT=30

# 知识库搜索配置
# KNOWLEDGE_SEARCH_LIMIT=5
# KNOWLEDGE_SIMILARITY_THRESHOLD=0.5
# KNOWLEDGE_MAX_CONTEXT_CHARS=8000
